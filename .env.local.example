# =============================================================================
# SREEVIGNIKAA SAREES - Environment Variables
# Copy this file to ".env.local" and fill in your real values
# =============================================================================

# Supabase Project Settings (get these from: Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Service role key (server-side only, used for admin/storage operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Live production website URL (used for WhatsApp product links)
NEXT_PUBLIC_SITE_URL=https://sreevignikaasarees.vercel.app
